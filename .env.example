# Hosted smoke checks: existing synthetic accounts in a DEVELOPMENT project only.
# Never use a service_role/secret key. Never commit real credentials.
SUPABASE_URL=https://your-development-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
TEST_USER_A_EMAIL=synthetic-a@example.invalid
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=synthetic-b@example.invalid
TEST_USER_B_PASSWORD=
# Explicit opt-in; creates one synthetic confirmed report in that project.
HANDE_ALLOW_TEST_WRITES=no
